app.post('/api/orders/:id/split', (req, res) => {
  const { id } = req.params;
  const idx = orders.findIndex(o => o.id === id);
  if (idx === -1) {
    return res.status(404).json({ error: 'Order not found' });
  }

  const order = orders[idx];
  if (order.items.length <= 1 && order.items[0].quantity === 1) {
    return res.status(400).json({ error: 'Order cannot be split further (only 1 item).' });
  }

  // Simple heuristic: split hazmat/heavy items, or just split into two orders roughly evenly
  const shipment1Items = [];
  const shipment2Items = [];
  
  order.items.forEach(item => {
    const isHeavyHazmat = item.sku.toLowerCase().includes('hz') || item.sku.toLowerCase().includes('heavy') || item.title.toLowerCase().includes('heavy');
    if (isHeavyHazmat) {
      shipment2Items.push(item);
    } else {
      shipment1Items.push(item);
    }
  });

  // If the heuristic didn't separate them, just split by index
  if (shipment1Items.length === 0 || shipment2Items.length === 0) {
    const half = Math.ceil(order.items.length / 2);
    shipment1Items.length = 0;
    shipment2Items.length = 0;
    shipment1Items.push(...order.items.slice(0, half));
    shipment2Items.push(...order.items.slice(half));
  }

  const newOrder1 = { ...order, id: `${order.id}-A`, items: shipment1Items, tags: [...(order.tags || []), 'Split Order'] };
  const newOrder2 = { ...order, id: `${order.id}-B`, items: shipment2Items, tags: [...(order.tags || []), 'Split Order'] };

  // Replace original order with newOrder1, insert newOrder2
  orders.splice(idx, 1, newOrder1, newOrder2);

  addLog('info', 'system', `Order ${order.id} automatically split into 2 shipments based on SKU rules.`);
  res.json({ success: true, newOrders: [newOrder1, newOrder2] });
});

// POST update order notes, shippingDate, weight, dimensions, tags, carrier etc.
app.post('/api/orders/update', (req, res) => {
  const { id, notes, tags, weightOz, dimensions, shippingDate, carrier, selectedRate, status } = req.body;
  const idx = orders.findIndex(o => o.id === id);
  if (idx !== -1) {
    orders[idx] = {
      ...orders[idx],
      notes: notes !== undefined ? notes : orders[idx].notes,
      tags: tags !== undefined ? tags : orders[idx].tags,
      weightOz: weightOz !== undefined ? (weightOz ? Number(weightOz) : undefined) : orders[idx].weightOz,
      dimensions: dimensions !== undefined ? (dimensions ? {
        length: Number(dimensions.length),
        width: Number(dimensions.width),
        height: Number(dimensions.height),
      } : undefined) : orders[idx].dimensions,
      shippingDate: shippingDate !== undefined ? shippingDate : orders[idx].shippingDate,
      carrier: carrier !== undefined ? carrier : orders[idx].carrier,
      selectedRate: selectedRate !== undefined ? selectedRate : orders[idx].selectedRate,
      status: status !== undefined ? status : orders[idx].status,
    };
    addLog('info', 'system', `Manual edit saved for order ${id}.`);
    res.json({ success: true, order: orders[idx], orders });
    broadcast('orders', orders);
  } else {
    res.status(404).json({ error: 'Order not found' });
  }
});
let sseClients: any[] = [];

function broadcast(type: string, data: any) {
  const message = `event: ${type}\ndata: ${JSON.stringify(data)}\n\n`;
  sseClients.forEach(client => client.write(message));
}

app.get('/api/stream', (req, res) => {
  res.setHeader('Content-Type', 'text/event-stream');
  res.setHeader('Cache-Control', 'no-cache');
  res.setHeader('Connection', 'keep-alive');
  
  // Send initial ping
  res.write('event: ping\ndata: ok\n\n');
  
  sseClients.push(res);
  
  req.on('close', () => {
    sseClients = sseClients.filter(client => client !== res);
  });
});

