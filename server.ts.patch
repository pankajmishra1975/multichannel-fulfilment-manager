// POST bulk CSV import products
app.post('/api/products/import', (req, res) => {
  const { items } = req.body;
  if (!Array.isArray(items)) {
    return res.status(400).json({ error: 'Payload items must be an array' });
  }

  let imported = 0;
  let updated = 0;

  items.forEach((item: any) => {
    if (!item.sku) return;
    const existingIdx = products.findIndex(p => p.sku === item.sku);

    const mappedVal = item.mappedSku || item.sku;
    const descVal = item.description || 'Imported via CSV product catalog upload.';
    const buyingVal = item.buyingPrice ? Number(item.buyingPrice) : 0;
    const sellingVal = item.sellingPrice ? Number(item.sellingPrice) : 0;
    const weightVal = item.weight ? Number(item.weight) : undefined;
    const sizeVal = item.size || undefined;
    const stockVal = item.stock !== undefined ? Number(item.stock) : (item.quantity !== undefined ? Number(item.quantity) : 10);
    const vatVal = (item.vatType || item.vatOrNonVat || 'VAT').toString().toLowerCase().includes('non') ? 'Non VAT' : 'VAT';
    const imageVal = item.image || (Array.isArray(item.images) && item.images.length > 0 ? item.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200&auto=format&fit=crop&q=60');
    const imagesVal = Array.isArray(item.images) ? item.images : (item.image ? [item.image] : []);
    const commissionVal = item.commission !== undefined ? Number(item.commission) : 0;
    const shippingCostVal = item.shippingCost !== undefined ? Number(item.shippingCost) : 0;

    const cleanItem = {
      sku: item.sku,
      name: item.name || item.productName || 'Imported Product',
      description: descVal,
      weight: weightVal,
      size: sizeVal,
      buyingPrice: buyingVal,
      sellingPrice: sellingVal,
      commission: commissionVal,
      shippingCost: shippingCostVal,
      vatType: vatVal,
      image: imageVal,
      images: imagesVal,
      stock: stockVal,
      mappedSku: mappedVal,
      source: item.source || 'none'
    };

    if (existingIdx !== -1) {
      products[existingIdx] = {
        ...products[existingIdx],
        ...cleanItem
      };
      updated++;
    } else {
      products.push(cleanItem);
      imported++;
    }
  });

  addLog('info', 'system', `Bulk CSV catalog upload complete. Created ${imported} new items, updated ${updated} existing records.`);
  res.json({ success: true, importedCount: imported, updatedCount: updated, products });
});

