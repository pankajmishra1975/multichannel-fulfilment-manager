    { id: `rate_ship_v2_ground_${orderId}`, carrierName: 'Amazon Shipping v2', serviceName: 'Amazon Ground Shipping v2', amount: Math.round((3.60 + baseWeightFactor * 0.85) * 100) / 100, currency: appCurrency, deliveryDays: 3, shippingType: 'shipping_v2' as const },
    { id: `rate_ship_v2_premium_${orderId}`, carrierName: 'Amazon Shipping v2', serviceName: 'Amazon Premium Delivery 1-Day', amount: Math.round((12.50 + baseWeightFactor * 2.10) * 100) / 100, currency: appCurrency, deliveryDays: 1, shippingType: 'shipping_v2' as const }
  ];

  const selectedRate = rates.find(r => r.id === rateId) || rates[0];

