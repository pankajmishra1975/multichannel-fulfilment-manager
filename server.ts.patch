import fs from 'fs';
import path from 'path';

const DB_FILE = path.join(process.cwd(), 'database.json');

function saveToDB() {
  const data = {
    products,
    orders,
    appOrigin,
    appCurrency,
    appUnitSystem,
    inventoryThreshold,
    skuMappings,
    carrierLogs
  };
  fs.writeFileSync(DB_FILE, JSON.stringify(data, null, 2));
}

function loadFromDB() {
  if (fs.existsSync(DB_FILE)) {
    try {
      const data = JSON.parse(fs.readFileSync(DB_FILE, 'utf-8'));
      if (data.products && Array.isArray(data.products)) products = data.products;
      if (data.orders && Array.isArray(data.orders)) orders = data.orders;
      if (data.appOrigin) appOrigin = data.appOrigin;
      if (data.appCurrency) appCurrency = data.appCurrency;
      if (data.appUnitSystem) appUnitSystem = data.appUnitSystem;
      if (data.inventoryThreshold !== undefined) inventoryThreshold = data.inventoryThreshold;
      if (data.skuMappings && Array.isArray(data.skuMappings)) skuMappings = data.skuMappings;
      if (data.carrierLogs && Array.isArray(data.carrierLogs)) carrierLogs = data.carrierLogs;
    } catch (e) {
      console.error('Failed to load DB', e);
    }
  }
}


