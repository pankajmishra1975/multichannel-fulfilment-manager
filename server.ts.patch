// POST add/update SKU mapping
app.post('/api/sku-mappings', (req, res) => {
  const { id, channelSku, warehouseSku, channel, force } = req.body;
  if (!channelSku || !warehouseSku) {
    return res.status(400).json({ error: 'Channel SKU and Warehouse SKU are required.' });
  }

  // Verify warehouse SKU exists
  const exists = products.some(p => p.sku === warehouseSku);
  if (!exists) {
    return res.status(400).json({ error: `Warehouse SKU [${warehouseSku}] does not exist in the catalog.` });
  }

  // Validation: Check if target SKU is already mapped to another channel SKU to prevent duplicate routing
  if (!force) {
    const alreadyMapped = skuMappings.find(m => m.warehouseSku === warehouseSku && m.channelSku !== channelSku && (!id || m.id !== id));
    if (alreadyMapped) {
      return res.status(400).json({ 
        error: `Duplicate Routing Warning: The target warehouse SKU [${warehouseSku}] is already mapped to another channel SKU [${alreadyMapped.channelSku}] on "${alreadyMapped.channel}".` 
      });
    }
  }

  if (id) {
    const idx = skuMappings.findIndex(m => m.id === id);
    if (idx !== -1) {
      skuMappings[idx] = {
        ...skuMappings[idx],
        channelSku,
        warehouseSku,
        channel: channel || 'all'
      };
      addLog('info', 'system', `Updated SKU Mapping rule: Store SKU [${channelSku}] -> Warehouse [${warehouseSku}]`);
      res.json({ success: true, mapping: skuMappings[idx] });
    } else {
      res.status(404).json({ error: 'Mapping not found' });
    }
  } else {
    // Check duplicate channelSku
    const duplicate = skuMappings.some(m => m.channelSku === channelSku && m.channel === (channel || 'all'));
    if (duplicate) {
      return res.status(400).json({ error: `A mapping rule for Channel SKU [${channelSku}] already exists.` });
    }

    const newMapping = {
      id: 'map_' + Math.random().toString(36).substring(2, 11),
      channelSku,
      warehouseSku,
      channel: channel || 'all'
    };
    skuMappings.push(newMapping);
    addLog('info', 'system', `Created SKU Mapping rule: Store SKU [${channelSku}] -> Warehouse [${warehouseSku}]`);
    res.json({ success: true, mapping: newMapping });
  }
});

