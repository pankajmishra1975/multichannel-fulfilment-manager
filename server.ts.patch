// POST save shipping rule
app.post('/api/shipping-rules', (req, res) => {
  const { id, name, description, isActive, priority, conditions, actions } = req.body;
  
  if (!name || !conditions || !Array.isArray(conditions) || !actions || !Array.isArray(actions)) {
    return res.status(400).json({ error: 'Name, conditions (array), and actions (array) are required.' });
  }

  if (id) {
    const idx = shippingRules.findIndex(r => r.id === id);
    if (idx !== -1) {
      shippingRules[idx] = {
        ...shippingRules[idx],
        name,
        description: description || '',
        isActive: isActive !== undefined ? !!isActive : true,
        priority: priority !== undefined ? Number(priority) : 0,
        conditions,
        actions
      };
      addLog('info', 'system', `Updated automation rule: "${name}" (Priority: ${priority})`);
      res.json({ success: true, rule: shippingRules[idx] });
    } else {
      res.status(404).json({ error: 'Rule not found' });
    }
  } else {
    const newRule = {
      id: 'rule_' + Math.random().toString(36).substring(2, 11),
      name,
      description: description || '',
      isActive: isActive !== undefined ? !!isActive : true,
      priority: priority !== undefined ? Number(priority) : 0,
      conditions,
      actions
    };
    shippingRules.push(newRule);
    addLog('info', 'system', `Created automation rule: "${name}"`);
    res.json({ success: true, rule: newRule });
  }
});

