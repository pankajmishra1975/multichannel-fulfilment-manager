// Update order specs (weight and dimensions)
app.post('/api/orders/update-specs', (req, res) => {
  const { id, weightOz, dimensions } = req.body;
  const idx = orders.findIndex(o => o.id === id);
  if (idx !== -1) {
    orders[idx] = {
      ...orders[idx],
      weightOz: weightOz ? Number(weightOz) : undefined,
      dimensions: dimensions ? {
        length: Number(dimensions.length),
        width: Number(dimensions.width),
        height: Number(dimensions.height),
      } : undefined
    };
    addLog('info', 'system', `Updated order specs for ${id}: Weight=${weightOz || 'N/A'} oz, Dimensions=${dimensions ? `${dimensions.length}x${dimensions.width}x${dimensions.height}` : 'N/A'}`);
    res.json({ success: true, order: orders[idx] });
  } else {
    res.status(404).json({ error: 'Order not found' });
  }
});

// Bulk update order specs (weight and dimensions)
app.post('/api/orders/bulk-update-specs', (req, res) => {
  const { ids, weightOz, dimensions } = req.body;
  if (!ids || !Array.isArray(ids)) {
    return res.status(400).json({ error: 'ids array is required.' });
  }
  let count = 0;
  orders.forEach(o => {
    if (ids.includes(o.id)) {
      if (weightOz !== undefined) o.weightOz = weightOz ? Number(weightOz) : undefined;
      if (dimensions !== undefined) {
        o.dimensions = dimensions ? {
          length: Number(dimensions.length),
          width: Number(dimensions.width),
          height: Number(dimensions.height)
        } : undefined;
      }
      count++;
    }
  });
  addLog('info', 'system', `Bulk specifications updated for ${count} orders.`);
  res.json({ success: true, count, orders });
});

