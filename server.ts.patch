function syncProductStock(p: any) {
  if (p.isBundle) {
    let minStock = Infinity;
    if (p.bundleComponents && p.bundleComponents.length > 0) {
      p.bundleComponents.forEach((comp: any) => {
        const compProd = products.find(prod => prod.sku === comp.sku);
        if (compProd) {
          syncProductStock(compProd);
          const potentialBundleStock = Math.floor((compProd.stock || 0) / comp.quantity);
          if (potentialBundleStock < minStock) {
            minStock = potentialBundleStock;
          }
        }
      });
    }
    p.stock = minStock === Infinity ? 0 : minStock;
  } else {
    if (!p.stockByWarehouse) {
      p.stockByWarehouse = { 'wh-main': p.stock || 0 };
    }
    p.stock = Object.keys(p.stockByWarehouse).reduce((sum, key) => sum + (Number(p.stockByWarehouse[key]) || 0), 0);
  }
}

