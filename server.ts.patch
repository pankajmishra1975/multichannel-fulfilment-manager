// Gemini-API: Intelligent Store Listing SKU Mapping Suggestion Engine
app.post('/api/ai/sku-mappings/suggest', async (req, res) => {
  const { channelSku, channelTitle, channelImage, channel } = req.body;

  if (!channelSku || !channelTitle) {
    return res.status(400).json({ error: 'Channel SKU and Title are required for suggestions.' });
  }

  // Define offline helper function first to use in fallback catch
  const calculateLocalFuzzyMatch = (cSku: string, cTitle: string, cImg: string, warehouseProducts: any[]) => {
    let bestMatch: any = null;
    let bestScore = -1;
    let bestType = 'hybrid';
    let bestReason = '';

    for (const p of warehouseProducts) {
      let skuScore = 0;
      let titleScore = 0;
      let imageScore = 0;
      let reasons: string[] = [];

      const cleanCSku = cSku.toLowerCase();
      const cleanWSku = p.sku.toLowerCase();

      // 1. SKU Matching Score
      if (cleanCSku === cleanWSku) {
        skuScore = 45;
        reasons.push("SKU code is an exact match");
      } else {
        const cParts = cleanCSku.split(/[-_\s]+/);
        const wParts = cleanWSku.split(/[-_\s]+/);
        let overlaps = 0;
        for (const part of cParts) {
          if (part.length > 2 && wParts.includes(part)) {
            overlaps++;
          }
        }
        if (overlaps > 0) {
          skuScore = 15 + Math.min(overlaps * 10, 25);
          reasons.push(`SKU codes share segment overlaps ("${overlaps} matching identifiers")`);
        } else if (cleanCSku.substring(0, 3) === cleanWSku.substring(0, 3)) {
          skuScore = 10;
          reasons.push("SKU codes share the same marketplace channel prefix");
        }
      }

      // 2. Title Semantics Word Match
      const cWords = cTitle.toLowerCase().replace(/[^\w\s]/g, '').split(/\s+/).filter(w => w.length > 2);
      const pWords = p.name.toLowerCase().replace(/[^\w\s]/g, '').split(/\s+/).filter(w => w.length > 2);
      const stopwords = ["with", "and", "the", "for", "out", "new", "pro", "premium", "inch", "high", "speed"];
      const filteredCW = cWords.filter(w => !stopwords.includes(w));
      const filteredPW = pWords.filter(w => !stopwords.includes(w));

      const matchingWords = filteredCW.filter(w => filteredPW.includes(w));
      if (matchingWords.length > 0) {
        titleScore = (matchingWords.length / Math.max(filteredPW.length, 1)) * 40;
        reasons.push(`Highly overlapping keyword matches: "${matchingWords.slice(0, 3).join(', ')}"`);
      }

      // 3. Image Keywords Match
      const cImgUrl = (cImg || '').toLowerCase();
      const pImgUrl = (p.image || '').toLowerCase();
      const imageKeywords = ["earbuds", "cable", "chair", "blender", "board", "cutting", "watch", "yoga", "mat"];
      let imageMatchedWord = '';
      for (const kw of imageKeywords) {
        if (cImgUrl.includes(kw) && pImgUrl.includes(kw)) {
          imageScore = 15;
          imageMatchedWord = kw;
          break;
        }
      }
      if (imageScore > 0) {
        reasons.push(`Visual tags match category "${imageMatchedWord}"`);
      }

      const totalScore = skuScore + titleScore + imageScore;
      if (totalScore > bestScore) {
        bestScore = totalScore;
        bestMatch = p;
        if (skuScore > 20 && titleScore > 20) {
          bestType = 'hybrid';
        } else if (skuScore > titleScore) {
          bestType = 'sku';
        } else {
          bestType = 'title';
        }
        bestReason = reasons.join(', ') || 'Partial matching identifiers detected.';
      }
    }

    const confidence = Math.min(Math.round(bestScore), 100);
    if (confidence < 15 || !bestMatch) {
      return {
        suggestedWarehouseSku: '',
        suggestedProductName: '',
        confidence: 0,
        matchReason: 'No physical warehouse product in the catalog matches this external store listing.',
        matchType: 'hybrid'
      };
    }

    return {
      suggestedWarehouseSku: bestMatch.sku,
      suggestedProductName: bestMatch.name,
      confidence,
      matchReason: bestReason,
      matchType: bestType
    };
  };

  const prompt = `You are an expert e-commerce catalog integration assistant.
You are helping to map a merchant's sales channel product listing to an internal physical warehouse product.

Channel Listing to map:
- SKU: ${channelSku}
- Title: "${channelTitle}"
- Image: "${channelImage || 'none'}"
- Channel: "${channel || 'all'}"

Available Physical Warehouse Products in Catalog:
${JSON.stringify(products.map(p => ({ sku: p.sku, name: p.name, description: p.description, image: p.image })))}

Please identify the single best matching warehouse product SKU from the list of available warehouse products.
Match it based on:
1. SKU naming similarities (e.g. matching codes, substrings, prefixes/suffixes, or common descriptors).
2. Title semantics (e.g. overlapping product types, categories, nouns, descriptors like "Earbuds", "Cable", "Blender").
3. Image similarity keywords (if URLs or themes seem related).

Provide your response in JSON format with this exact schema:
{
  "suggestedWarehouseSku": "The SKU code of the best matching physical warehouse product, or empty string if no product fits at all (e.g., less than 10% similarity)",
  "confidence": number, // A percentage between 0 and 100 indicating match confidence
  "matchReason": "A clear, professional, concise 1-sentence explanation of why this product is the best match (e.g., 'The channel SKU contains \"EARBUDS\" which matches internal Earbuds SKU AMZ-ELEC-402 with highly overlapping title keywords.')",
  "matchType": "sku" | "title" | "image" | "hybrid" // Choose the primary matching criteria
}
`;

  try {
    addLog('info', 'ai', `Requesting Gemini AI to find smart mapping connection suggestion for Store SKU [${channelSku}]...`);

    const response = await getAi().models.generateContent({
      model: 'gemini-3.5-flash',
      contents: prompt,
      config: {
        responseMimeType: 'application/json',
        responseSchema: {
          type: Type.OBJECT,
          properties: {
            suggestedWarehouseSku: { type: Type.STRING },
            confidence: { type: Type.INTEGER },
            matchReason: { type: Type.STRING },
            matchType: { type: Type.STRING }
          },
          required: ["suggestedWarehouseSku", "confidence", "matchReason", "matchType"]
        }
      }
    });

    const resultText = response.text || '{}';
    const parsedResult = JSON.parse(resultText);

    // Attach human readable name
    const matchedProduct = products.find(p => p.sku === parsedResult.suggestedWarehouseSku);
    parsedResult.suggestedProductName = matchedProduct ? matchedProduct.name : '';

    addLog('info', 'ai', `Gemini smart mapping completed: Suggested [${parsedResult.suggestedWarehouseSku}] with ${parsedResult.confidence}% confidence.`);
    res.json(parsedResult);
  } catch (error: any) {
    console.error('Gemini mapping suggestions failed:', error);
    addLog('warn', 'ai', `Gemini mapping advice failed: ${error.message || error}. Falling back to deterministic fuzzy-logic matching.`);

    // Perform offline fallback calculation
    const fallbackResult = calculateLocalFuzzyMatch(channelSku, channelTitle, channelImage, products);
    res.json(fallbackResult);
  }
});

