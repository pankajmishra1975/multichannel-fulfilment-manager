// POST bulk CSV import SKU mappings
app.post('/api/sku-mappings/import', (req, res) => {
  const { items, force } = req.body;
  if (!Array.isArray(items)) {
    return res.status(400).json({ error: 'Payload must contain items array' });
  }

  let imported = 0;
  let skipped = 0;

  items.forEach((item: any) => {
    const channelSku = item.channelsku || item.marketplacesku || item.channelsku || item.marketplacesku || item.channel_sku || item.marketplace_sku || item.channelsku || item.channelSku;
    const warehouseSku = item.warehousesku || item.internalsku || item.warehousesku || item.internalsku || item.warehouse_sku || item.internal_sku || item.sku || item.warehouseSku;
    const channel = item.channel || item.source || 'all';

    if (!channelSku || !warehouseSku) {
      skipped++;
      return;
    }

    // Ensure warehouse SKU exists
    const exists = products.some(p => p.sku === warehouseSku);
    if (!exists) {
      skipped++;
      return;
    }

    // Validation: Check duplicate target SKU during CSV import if not forced
    if (!force) {
      const alreadyMapped = skuMappings.some(m => m.warehouseSku === warehouseSku && m.channelSku !== channelSku);
      if (alreadyMapped) {
        skipped++;
        return;
      }
    }

    // Avoid duplicates or update
    const existingIdx = skuMappings.findIndex(m => m.channelSku === channelSku);
    if (existingIdx !== -1) {
      skuMappings[existingIdx] = {
        ...skuMappings[existingIdx],
        warehouseSku,
        channel: channel.toLowerCase()
      };
      imported++;
    } else {
      skuMappings.push({
        id: 'map_' + Math.random().toString(36).substring(2, 11),
        channelSku,
        warehouseSku,
        channel: channel.toLowerCase()
      });
      imported++;
    }
  });

  addLog('info', 'system', `Bulk CSV SKU Mapping import complete. Imported/Updated ${imported} rules, skipped ${skipped} invalid lines.`);
  res.json({ success: true, importedCount: imported, skippedCount: skipped, skuMappings });
});

