});

// Bulk buy shipping labels (Auto process & bulk print)
app.post('/api/shipping/bulk-buy', (req, res) => {
  const { orderIds, preferredType } = req.body; // preferredType: 'cheapest' | 'fastest' | 'buy_shipping' | 'shipping_v2'
  
  addLog('info', 'shipping_api', `Starting Bulk Purchase processing for ${orderIds.length} orders...`);
  
  let processedCount = 0;
  const processedOrders: any[] = [];

  orderIds.forEach((orderId: string) => {
    const idx = orders.findIndex(o => o.id === orderId);
    if (idx !== -1 && orders[idx].status !== 'shipped') {
      const order = orders[idx];
      const weightOz = order.weightOz || 16;
      const baseWeightFactor = weightOz / 16;

      // Establish simulated rates
      const rateQuotes = [
        { id: 'rate1', carrierName: 'Amazon Buy Shipping', serviceName: 'USPS Ground Advantage (via Amazon)', amount: Math.round((3.80 + baseWeightFactor * 0.95) * 100) / 100, currency: appCurrency, deliveryDays: 3, shippingType: 'buy_shipping' as const },
        { id: 'rate2', carrierName: 'Amazon Buy Shipping', serviceName: 'UPS Ground (via Buy Shipping)', amount: Math.round((7.20 + baseWeightFactor * 1.20) * 100) / 100, currency: appCurrency, deliveryDays: 2, shippingType: 'buy_shipping' as const },
        { id: 'rate3', carrierName: 'Amazon Shipping v2', serviceName: 'Amazon Ground Shipping v2', amount: Math.round((3.60 + baseWeightFactor * 0.85) * 100) / 100, currency: appCurrency, deliveryDays: 3, shippingType: 'shipping_v2' as const },
        { id: 'rate4', carrierName: 'Amazon Shipping v2', serviceName: 'Amazon Premium Delivery 1-Day', amount: Math.round((12.50 + baseWeightFactor * 2.10) * 100) / 100, currency: appCurrency, deliveryDays: 1, shippingType: 'shipping_v2' as const }
      ];

      // Filter based on preferredType
      let selected = rateQuotes[2]; // Default to Amazon Shipping v2 Ground (Cheapest)
      if (preferredType === 'fastest') {
        selected = rateQuotes.reduce((prev, curr) => prev.deliveryDays < curr.deliveryDays ? prev : curr);
      } else if (preferredType === 'cheapest') {
        selected = rateQuotes.reduce((prev, curr) => prev.amount < curr.amount ? prev : curr);
      } else if (preferredType === 'buy_shipping') {
        selected = rateQuotes.find(r => r.shippingType === 'buy_shipping') || rateQuotes[0];
      } else if (preferredType === 'shipping_v2') {
        selected = rateQuotes.find(r => r.shippingType === 'shipping_v2') || rateQuotes[2];
      }

      const prefix = selected.carrierName === 'Amazon Shipping v2' ? 'AMZN' : '1Z';
      const trackingNumber = prefix + Math.random().toString(36).substring(2, 16).toUpperCase();

      orders[idx] = {
        ...order,
        status: 'shipped',
        selectedRate: selected,
        trackingNumber,
        shippedAt: new Date().toISOString(),
        labelUrl: 'generated_label_base64_marker_placeholder',
      };
      processedOrders.push(orders[idx]);
      processedCount++;
      addLog('info', 'shipping_api', `[Bulk Purchase] Shipped ${orderId} via ${selected.carrierName} (${selected.serviceName}). Track: ${trackingNumber}`);
    }
  });

  addLog('info', 'system', `Bulk auto-printing queue ready: Generated ${processedCount} shipping labels.`);
  res.json({ success: true, processedCount, processedOrders });
});

