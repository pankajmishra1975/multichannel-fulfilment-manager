// POST Create WMS Purchase Order
app.post('/api/wms/purchase-orders', (req, res) => {
  const { supplierId, items, expectedDeliveryDate, notes } = req.body;

  if (!supplierId || !items || !Array.isArray(items) || items.length === 0) {
    return res.status(400).json({ error: 'Supplier and at least one item line are required.' });
  }

  const supplier = suppliers.find(s => s.id === supplierId);
  if (!supplier) {
    return res.status(404).json({ error: 'Selected supplier not found.' });
  }

  const count = purchaseOrders.length + 1;
  const poNumber = `PO-${new Date().getFullYear()}-${String(count).padStart(4, '0')}`;
  const totalAmount = items.reduce((sum, item) => sum + (Number(item.quantity) * Number(item.unitCost)), 0);

  const newPO = {
    id: 'po_' + Math.random().toString(36).substring(2, 11),
    poNumber,
    supplierId,
    supplierName: supplier.name,
    status: 'draft' as const,
    items: items.map(item => ({
      sku: item.sku,
      name: item.name || 'Unnamed Item',
      quantity: Number(item.quantity),
      unitCost: Number(item.unitCost),
      receivedQuantity: 0
    })),
    orderDate: new Date().toISOString(),
    expectedDeliveryDate: expectedDeliveryDate || new Date(Date.now() + 86400000 * supplier.leadTimeDays).toISOString(),
    notes: notes || '',
    totalAmount
  };

  purchaseOrders.unshift(newPO);
  addLog('info', 'system', `Draft Purchase Order created: ${poNumber} for ${supplier.name} (Total: $${totalAmount.toFixed(2)})`);
  res.json({ success: true, purchaseOrder: newPO });
});

// POST Update WMS Purchase Order Details / Status
app.post('/api/wms/purchase-orders/update', (req, res) => {
  const { id, status, expectedDeliveryDate, notes, items, receivedDate } = req.body;
  const idx = purchaseOrders.findIndex(p => p.id === id);
  
  if (idx !== -1) {
    const currentPO = purchaseOrders[idx];
    const oldStatus = currentPO.status;

    // Save previous items if we need them, update basic properties
    if (expectedDeliveryDate !== undefined) currentPO.expectedDeliveryDate = expectedDeliveryDate;
    if (notes !== undefined) currentPO.notes = notes;
    
    if (items !== undefined) {
      currentPO.items = items.map((i: any) => ({
        sku: i.sku,
        name: i.name,
        quantity: Number(i.quantity),
        unitCost: Number(i.unitCost),
        receivedQuantity: i.receivedQuantity !== undefined ? Number(i.receivedQuantity) : 0
      }));
      currentPO.totalAmount = currentPO.items.reduce((sum: number, i: any) => sum + (i.quantity * i.unitCost), 0);
    }

    if (status !== undefined && status !== oldStatus) {
      currentPO.status = status;
      if (status === 'received') {
        currentPO.receivedDate = receivedDate || new Date().toISOString();
        
        // Replenish physical catalog inventory stocks!
        currentPO.items.forEach((poItem: any) => {
          const productIdx = products.find(p => p.sku === poItem.sku);
          const productObj = products.find(p => p.sku === poItem.sku);
          if (productObj) {
            // Set receivedQuantity to full quantity if it was zero or undefined
            if (!poItem.receivedQuantity) {
              poItem.receivedQuantity = poItem.quantity;
            }
            if (!productObj.stockByWarehouse) {
              productObj.stockByWarehouse = { 'wh-main': productObj.stock || 0 };
            }
            productObj.stockByWarehouse['wh-main'] = (productObj.stockByWarehouse['wh-main'] || 0) + poItem.receivedQuantity;
            syncProductStock(productObj);
            addLog('info', 'system', `Received PO ${currentPO.poNumber}: Catalog SKU [${poItem.sku}] stock increased by +${poItem.receivedQuantity} units in Main Warehouse (New Total Synced Stock: ${productObj.stock}).`);
          }
        });
      }
      addLog('info', 'system', `Purchase Order ${currentPO.poNumber} state changed from [${oldStatus.toUpperCase()}] to [${status.toUpperCase()}].`);
    } else {
      addLog('info', 'system', `Purchase Order ${currentPO.poNumber} properties updated.`);
    }

    res.json({ success: true, purchaseOrder: currentPO, products });
  } else {
    res.status(404).json({ error: 'Purchase Order not found' });
  }
});

