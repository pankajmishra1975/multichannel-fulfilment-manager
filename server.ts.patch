app.post('/api/orders/bulk-action', (req, res) => {
  const { action, ids } = req.body;
  if (!ids || !Array.isArray(ids)) {
    return res.status(400).json({ error: 'IDs required' });
  }

  if (action === 'delete') {
    orders = orders.filter(o => !ids.includes(o.id));
    addLog('info', 'system', `Deleted ${ids.length} orders.`);
  } else if (action === 'cancel') {
    orders = orders.map(o => ids.includes(o.id) ? { ...o, status: 'cancelled' } : o);
    addLog('info', 'system', `Cancelled ${ids.length} orders.`);
  } else if (action === 'ship') {
    orders = orders.map(o => ids.includes(o.id) ? { ...o, status: 'shipped', trackingNumber: 'TRK-' + Math.random().toString(36).substring(2, 10).toUpperCase() } : o);
    addLog('info', 'system', `Marked ${ids.length} orders as SHIPPED and generated tracking numbers.`);
  } else if (action === 'notify_channels') {
    addLog('info', 'system', `Notified channels/stores for ${ids.length} shipped orders.`);
  }

  res.json({ success: true });
});

app.post('/api/orders/merge', (req, res) => {
  const { orderIds } = req.body;
  if (!orderIds || !Array.isArray(orderIds) || orderIds.length < 2) {
    return res.status(400).json({ error: 'At least two order IDs are required for merging.' });
  }

  const selectedOrders = orders.filter(o => orderIds.includes(o.id));
  if (selectedOrders.length !== orderIds.length) {
    return res.status(404).json({ error: 'One or more selected orders not found.' });
  }

  // Verify all selected orders are pending
  const nonPending = selectedOrders.filter(o => o.status !== 'pending');
  if (nonPending.length > 0) {
    return res.status(400).json({ error: 'Only pending orders can be merged.' });
  }

  // Verify they belong to the same customer
  const first = selectedOrders[0];
  const mismatchName = selectedOrders.some(o => 
    o.buyerName.toLowerCase().trim() !== first.buyerName.toLowerCase().trim()
  );
  
  const mismatchAddress = selectedOrders.some(o => 
    o.shippingAddress.addressLine1.toLowerCase().trim() !== first.shippingAddress.addressLine1.toLowerCase().trim() ||
    o.shippingAddress.postalCode.toLowerCase().trim() !== first.shippingAddress.postalCode.toLowerCase().trim()
  );

  if (mismatchName || mismatchAddress) {
    return res.status(400).json({ error: 'Selected orders must belong to the same customer (matching name and address line 1/zip code).' });
  }

  // Merge items list
  const mergedItems: any[] = [];
  selectedOrders.forEach(o => {
    o.items.forEach((item: any) => {
      const existing = mergedItems.find(i => i.sku === item.sku);
      if (existing) {
        existing.quantity += item.quantity;
      } else {
        mergedItems.push({ ...item });
      }
    });
  });

  // Calculate combined values
  const totalAmount = selectedOrders.reduce((sum, o) => sum + o.totalAmount, 0);
  const totalWeightOz = selectedOrders.reduce((sum, o) => sum + (o.weightOz || 0), 0);
  
  // Create combined order ID
  const mergedId = `MERGED-${first.id.replace('MERGED-', '')}-${Math.floor(Math.random() * 90 + 10)}`;

  // Combine tags
  const allTags = selectedOrders.flatMap(o => o.tags || []);
  const mergedTags = [...new Set([...allTags, 'Merged Order'])];

  // Keep first order as base, replace items, update values and logs
  const mergedOrder = {
    ...first,
    id: mergedId,
    items: mergedItems,
    totalAmount: Math.round(totalAmount * 100) / 100,
    weightOz: totalWeightOz > 0 ? totalWeightOz : undefined,
    // Clear rates so they can be re-calculated for the combined specs
    selectedRate: undefined,
    trackingNumber: undefined,
    labelUrl: undefined,
    shippedAt: undefined,
    tags: mergedTags,
    orderDate: new Date().toISOString()
  };

  // Remove old orders and add the merged one
  orders = orders.filter(o => !orderIds.includes(o.id));
  orders.unshift(mergedOrder);

  addLog('info', 'system', `Merged ${selectedOrders.length} orders for ${first.buyerName} into unified order ${mergedId}.`);

  res.json({ success: true, mergedOrder, orders });
  broadcast('orders', orders);
});

