// POST Add/Update Virtual/Remote Printer
app.post('/api/printers', (req, res) => {
  const { id, name, type, connection, status, ipAddress, port, paperSize, apiKey, isDefault } = req.body;

  if (!name) {
    return res.status(400).json({ error: 'Printer Name is required.' });
  }

  if (isDefault) {
    // Make sure no other printer is default
    virtualPrinters.forEach(p => p.isDefault = false);
  }

  if (id) {
    const idx = virtualPrinters.findIndex(p => p.id === id);
    if (idx !== -1) {
      virtualPrinters[idx] = {
        ...virtualPrinters[idx],
        name,
        type: type || 'thermal',
        connection: connection || 'virtual',
        status: status || 'online',
        ipAddress: ipAddress || '',
        port: port ? Number(port) : undefined,
        paperSize: paperSize || '4x6',
        apiKey: apiKey || '',
        isDefault: !!isDefault
      };
      addLog('info', 'system', `Remote Printer updated: ${name} (${connection.toUpperCase()})`);
      res.json({ success: true, printer: virtualPrinters[idx] });
    } else {
      res.status(404).json({ error: 'Printer not found' });
    }
  } else {
    const newPrinter = {
      id: 'printer_' + Math.random().toString(36).substring(2, 11),
      name,
      type: type || 'thermal',
      connection: connection || 'virtual',
      status: status || 'online',
      ipAddress: ipAddress || '',
      port: port ? Number(port) : undefined,
      paperSize: paperSize || '4x6',
      apiKey: apiKey || '',
      isDefault: !!isDefault
    };
    virtualPrinters.push(newPrinter);
    addLog('info', 'system', `New Remote Printer registered: ${name} via ${connection.toUpperCase()}`);
    res.json({ success: true, printer: newPrinter });
  }
});

// POST Delete Printer
app.post('/api/printers/delete', (req, res) => {
  const { id } = req.body;
  const idx = virtualPrinters.findIndex(p => p.id === id);
  if (idx !== -1) {
    const name = virtualPrinters[idx].name;
    virtualPrinters = virtualPrinters.filter(p => p.id !== id);
    // Guarantee at least one default if we have any left
    if (virtualPrinters.length > 0 && !virtualPrinters.some(p => p.isDefault)) {
      virtualPrinters[0].isDefault = true;
    }
    addLog('warn', 'system', `Remote Printer de-registered: ${name}`);
    res.json({ success: true, printers: virtualPrinters });
  } else {
    res.status(404).json({ error: 'Printer not found' });
  }
});

// POST Test Print (Trigger simulated remote label spool)
app.post('/api/printers/test-print', (req, res) => {
  const { id } = req.body;
  const printer = virtualPrinters.find(p => p.id === id);
  if (!printer) {
