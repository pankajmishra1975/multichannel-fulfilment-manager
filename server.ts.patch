// Helper to check if an order matches all conditions of a rule
function matchesConditions(order: any, conditions: any[]): boolean {
  if (!conditions || conditions.length === 0) return false;
  
  return conditions.every(cond => {
    let orderVal: any = undefined;
    
    switch (cond.field) {
      case 'source':
        orderVal = order.source;
        break;
      case 'sku':
        orderVal = order.items?.map((i: any) => i.sku).join(', ') || '';
        break;
      case 'skuCategory':
        const prodCategories = order.items?.map((i: any) => {
          const p = products.find(prod => prod.sku === i.sku || prod.mappedSku === i.sku);
          return p?.description || ''; // Check description or custom tags for categories like 'hazmat', 'heavy'
        }).join(' ') || '';
        orderVal = prodCategories.toLowerCase();
        break;
      case 'weightOz':
        orderVal = order.weightOz !== undefined ? Number(order.weightOz) : 0;
        break;
      case 'destinationState':
        orderVal = order.shippingAddress?.stateOrRegion || '';
        break;
      case 'destinationZip':
        orderVal = order.shippingAddress?.postalCode || order.shippingAddress?.zipCode || order.shippingAddress?.zip || '';
        break;
      case 'destinationCountry':
        orderVal = order.shippingAddress?.countryCode || '';
        break;
      case 'totalAmount':
        orderVal = Number(order.totalAmount || 0);
        break;
      case 'shippingDate':
        orderVal = order.shippingDate || '';
        break;
      default:
        return false;
    }
    
    const condValStr = String(cond.value).toLowerCase().trim();
    const orderValStr = String(orderVal).toLowerCase().trim();
    
    switch (cond.operator) {
      case 'equals':
        return orderValStr === condValStr;
      case 'contains':
        return orderValStr.includes(condValStr);
      case 'starts_with':
        return orderValStr.startsWith(condValStr);
      case 'greater_than':
        return Number(orderVal) > Number(cond.value);
      case 'less_than':
        return Number(orderVal) < Number(cond.value);
      case 'is_empty':
        return !orderVal || orderVal === 0 || orderVal === '';
      case 'is_not_empty':
        return !!orderVal && orderVal !== 0 && orderVal !== '';
      default:
        return false;
    }
  });
}

// Helper to apply rule actions on an order
function applyRuleActions(order: any, actions: any[]): boolean {
  let modificationsMade = false;
  actions.forEach(act => {
    switch (act.type) {
      case 'assign_carrier':
        if (order.carrier !== act.value) {
          order.carrier = act.value;
          modificationsMade = true;
        }
        break;
      case 'assign_service':
        const rateAmount = order.weightOz ? Math.round((4.00 + (order.weightOz / 16) * 1.10) * 100) / 100 : 5.50;
        const rate = {
          id: `rate_auto_${order.id}_${Math.floor(Math.random() * 1000)}`,
          carrierName: order.carrier || 'Amazon Shipping v2',
          serviceName: act.value,
          amount: rateAmount,
          currency: order.currency || appCurrency,
          deliveryDays: 2,
          shippingType: (order.carrier || '').toLowerCase().includes('buy') ? 'buy_shipping' : 'shipping_v2'
        };
        order.selectedRate = rate;
        modificationsMade = true;
        break;
      case 'add_tag':
        if (!order.tags) order.tags = [];
        if (!order.tags.includes(act.value)) {
          order.tags.push(act.value);
          modificationsMade = true;
        }
        break;
      case 'add_note':
        if (!order.notes) {
          order.notes = act.value;
          modificationsMade = true;
        } else if (!order.notes.includes(act.value)) {
          order.notes = order.notes + ' | ' + act.value;
          modificationsMade = true;
        }
        break;
      case 'require_shipping_date':
        if (!order.shippingDate) {
          const tomorrow = new Date();
          tomorrow.setDate(tomorrow.getDate() + 1);
          order.shippingDate = tomorrow.toISOString().split('T')[0];
          modificationsMade = true;
        }
        break;
      case 'set_weight':
        if (!order.weightOz) {
          order.weightOz = Number(act.value) || 16;
          modificationsMade = true;
        }
        break;
      case 'park_order':
        if (order.status !== 'parked') {
          order.status = 'parked';
          if (!order.tags) order.tags = [];
          if (!order.tags.includes('Parked')) {
            order.tags.push('Parked');
          }
          modificationsMade = true;
        }
        break;
      case 'split_order':
        const totalQty = order.items?.reduce((sum: number, i: any) => sum + (i.quantity || 1), 0) || 0;
        if (totalQty > 1 && !order.isSplitParent) {
          order.isSplitParent = true;
          const newOrdersToCreate: any[] = [];
          order.items.forEach((item: any, idx: number) => {
            if (item.quantity > 1) {
              for (let q = 0; q < item.quantity; q++) {
                const subOrder = JSON.parse(JSON.stringify(order));
                subOrder.id = `${order.id}-S${idx + 1}-${q + 1}`;
                subOrder.items = [{ ...item, quantity: 1 }];
                subOrder.totalAmount = Math.round((order.totalAmount / totalQty) * 100) / 100;
                subOrder.isSplitParent = false;
                subOrder.status = 'pending';
                subOrder.tags = [...(subOrder.tags || []), 'Split Order'];
                newOrdersToCreate.push(subOrder);
              }
            } else {
              const subOrder = JSON.parse(JSON.stringify(order));
              subOrder.id = `${order.id}-S${idx + 1}-1`;
              subOrder.items = [{ ...item }];
              subOrder.totalAmount = Math.round((order.totalAmount / totalQty) * 100) / 100;
              subOrder.isSplitParent = false;
              subOrder.status = 'pending';
              subOrder.tags = [...(subOrder.tags || []), 'Split Order'];
              newOrdersToCreate.push(subOrder);
            }
          });
          order.status = 'parked'; // Original is parked
          order.tags = [...(order.tags || []), 'Splitted Parent'];
          orders.push(...newOrdersToCreate); saveToDB();
          modificationsMade = true;
        }
        break;
    }
  });
  return modificationsMade;
}

// Global evaluation runner
function runRulesEvaluationOnPending() {
  const activeRules = shippingRules
    .filter(r => r.isActive)
    .sort((a, b) => b.priority - a.priority);

  if (activeRules.length === 0) return 0;

  let totalApplied = 0;

  orders.forEach(order => {
    if (order.status !== 'pending') return;

    activeRules.forEach(rule => {
      if (matchesConditions(order, rule.conditions)) {
        const changed = applyRuleActions(order, rule.actions);
        if (changed) {
          totalApplied++;
          addLog('info', 'system', `[Rules Engine] Automated order ${order.id} via Rule "${rule.name}"`);
        }
      }
    });
  });

  return totalApplied;
}

